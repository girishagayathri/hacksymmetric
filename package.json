{
  "name": "okgadi-fleet-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api": "node server/index.js",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "deploy:up": "docker compose --env-file .env.production -f compose.production.yaml up --build -d --wait",
    "deploy:down": "docker compose --env-file .env.production -f compose.production.yaml down",
    "ai": "py -3.14 -m uvicorn services.intelligence.main:app --host 127.0.0.1 --port 8000",
    "train:ml": "py -3.14 services/intelligence/train_model.py",
    "dev:full": "docker compose up -d --wait && concurrently -k -n api,ai,web \"npm:api\" \"npm:ai\" \"npm:dev\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.9.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
