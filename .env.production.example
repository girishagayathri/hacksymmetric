# Copy to .env.production on the host and replace every example value.
# Use long random alphanumeric database/cache passwords so connection URLs need no escaping.
DOMAIN=fleet.example.com

POSTGRES_DB=okgadi
POSTGRES_USER=okgadi
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_SECRET

MONGO_INITDB_ROOT_USERNAME=okgadi-admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_SECRET
MONGODB_DATABASE=okgadi_telemetry

REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_SECRET